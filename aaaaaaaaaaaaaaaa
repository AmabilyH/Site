class MainActivity : ComponentActivity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        enableEdgeToEdge()

        setContent {
            MaterialTheme {
                WishlistScreen()
            }
        }
    }
}

data class ItemDesejo(
    val id: Int,
    val nome: String,
    val imagem: String,
    var concluido: Boolean = false
)

@Composable
fun WishlistScreen() {

    val lista = remember {
        mutableStateListOf(
            ItemDesejo(1, "Carro", "https://picsum.photos/200/300"),
            ItemDesejo(2, "Escova", "https://picsum.photos/200/300"),
            ItemDesejo(3, "Anel", "https://picsum.photos/200/300"),
            ItemDesejo(4, "Brinco", "https://picsum.photos/200/300"),
            ItemDesejo(5, "Celular", "https://picsum.photos/200/300"),
            ItemDesejo(6, "Bolsa", "https://picsum.photos/200/300"),
            ItemDesejo(7, "Espelho", "https://picsum.photos/200/300")
        )
    }

    var contador by remember { mutableIntStateOf(8) }

    Column(
        modifier = Modifier
            .fillMaxSize()
            .background(Color(0xFF9ECBEE))
            .padding(16.dp),
        horizontalAlignment = Alignment.CenterHorizontally
    ) {

        Image(
            painter = painterResource(id = R.drawable.logo),
            contentDescription = "Logo",
            modifier = Modifier
                .size(100.dp)
                .clip(CircleShape)
        )

        Spacer(modifier = Modifier.height(8.dp))

        Text(
            text = "Objetivos",
            style = MaterialTheme.typography.headlineMedium,
            color = Color(0xFF180128)
        )

        Spacer(modifier = Modifier.height(12.dp))

        Button(
            onClick = {
                lista.add(
                    ItemDesejo(
                        id = contador,
                        nome = "Novo Item $contador",
                        imagem = "https://picsum.photos/200/300"
                    )
                )
                contador++
            }
        ) {
            Text("Adicionar Item")
        }

        Spacer(modifier = Modifier.height(16.dp))

        LazyColumn(
            verticalArrangement = Arrangement.spacedBy(12.dp),
            modifier = Modifier.fillMaxSize()
        ) {
            items(lista, key = { it.id }) { item ->
                ItemCard(item) { checked ->
                    item.concluido = checked
                }
            }
        }
    }
}

@Composable
fun ItemCard(
    item: ItemDesejo,
    onCheckedChange: (Boolean) -> Unit
) {

    Card(
        modifier = Modifier.fillMaxWidth(),
        shape = RoundedCornerShape(12.dp),
        colors = CardDefaults.cardColors(
            containerColor = Color(0xFF7457EA)
        )
    ) {

        Row(
            modifier = Modifier.padding(12.dp),
            verticalAlignment = Alignment.CenterVertically
        ) {

            AsyncImage(
                model = item.imagem,
                contentDescription = item.nome,
                modifier = Modifier
                    .size(70.dp)
                    .clip(RoundedCornerShape(8.dp)),
                contentScale = ContentScale.Crop,
                placeholder = painterResource(R.drawable.loading),
                error = painterResource(R.drawable.erro)
            )

            Spacer(modifier = Modifier.width(10.dp))

            Checkbox(
                checked = item.concluido,
                onCheckedChange = onCheckedChange
            )

            Text(
                text = item.nome,
                modifier = Modifier
                    .padding(start = 8.dp)
                    .weight(1f)
                    .alpha(if (item.concluido) 0.5f else 1f),
                style = MaterialTheme.typography.titleMedium,
                textDecoration = if (item.concluido)
                    TextDecoration.LineThrough
                else
                    TextDecoration.None
            )
        }
    }
}
